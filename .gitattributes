# Git LFS tracked binary patterns.
# Any file matching these patterns is stored as an LFS pointer in git
# and fetched on demand via `git lfs pull`.
#
# To track a new pattern: `git lfs track "*.ext"` (updates this file).
# To re-migrate existing history after adding a pattern:
#   git lfs migrate import --include="*.ext" --everything

# --- Raster images ---
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.tiff   filter=lfs diff=lfs merge=lfs -text
*.bmp    filter=lfs diff=lfs merge=lfs -text
*.ico    filter=lfs diff=lfs merge=lfs -text
# --- Vector / design source files ---
*.psd    filter=lfs diff=lfs merge=lfs -text
*.ai     filter=lfs diff=lfs merge=lfs -text
*.sketch filter=lfs diff=lfs merge=lfs -text
*.fig    filter=lfs diff=lfs merge=lfs -text
*.afdesign filter=lfs diff=lfs merge=lfs -text
*.afphoto  filter=lfs diff=lfs merge=lfs -text
*.xd     filter=lfs diff=lfs merge=lfs -text
# --- Documents ---
*.pdf    filter=lfs diff=lfs merge=lfs -text
# --- Video / audio ---
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.mov    filter=lfs diff=lfs merge=lfs -text
*.webm   filter=lfs diff=lfs merge=lfs -text
*.mkv    filter=lfs diff=lfs merge=lfs -text
*.m4v    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.m4a    filter=lfs diff=lfs merge=lfs -text
# --- Fonts ---
*.woff   filter=lfs diff=lfs merge=lfs -text
*.woff2  filter=lfs diff=lfs merge=lfs -text
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text
*.eot    filter=lfs diff=lfs merge=lfs -text
# --- Archives ---
*.zip    filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tgz    filter=lfs diff=lfs merge=lfs -text
*.7z     filter=lfs diff=lfs merge=lfs -text
# --- Remotion pre-built bundle artifacts (committed in video-remotion/build/) ---
# These are large committed build outputs. Keep in LFS rather than removing
# so the documented workflow ("Pre-built Remotion bundles are committed") still
# works without blowing up clones.
# Two patterns needed: chunked bundles (e.g. 267.bundle.js) AND the root
# entry bundle (just bundle.js / bundle.js.map). Glob `*` requires >=1 char.
*.bundle.js     filter=lfs diff=lfs merge=lfs -text
*.bundle.js.map filter=lfs diff=lfs merge=lfs -text
bundle.js       filter=lfs diff=lfs merge=lfs -text
bundle.js.map   filter=lfs diff=lfs merge=lfs -text
